---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { animals } from '../../data/animals';
import { ArrowLeft, Heart, CheckCircle2, Calendar, ShieldCheck } from 'lucide-astro';

export async function getStaticPaths() {
  return animals.map((animal) => ({
    params: { id: animal.id },
    props: { animal },
  }));
}

const { animal } = Astro.props;
---

<Layout title={`${animal.name} | Historia de Rescate - Fundación Huellitas`}>
  <Header />
  
  <main class="py-12 bg-brand-beige/30 dark:bg-dark-bg min-h-screen">
    <div class="max-w-5xl mx-auto px-4">
      
      <!-- Botón Volver -->
      <a
        href="/#animales"
        class="inline-flex items-center gap-2 text-xs font-bold text-zinc-600 dark:text-zinc-300 hover:text-brand-terracotta transition-colors mb-8"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Volver a la lista de rescatados</span>
      </a>

      <div class="grid lg:grid-cols-12 gap-8 items-start">
        
        <!-- Galería (7 Cols) -->
        <div class="lg:col-span-7 space-y-4">
          <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-lg bg-zinc-100 dark:bg-zinc-800">
            <img
              src={animal.image}
              alt={animal.name}
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Muestra miniaturas de la galería si existen -->
          {animal.gallery && animal.gallery.length > 1 && (
            <div class="grid grid-cols-3 gap-3">
              {animal.gallery.map((imgUrl, index) => (
                <div class="aspect-square rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 shadow-sm border border-zinc-200/60 dark:border-zinc-700">
                  <img src={imgUrl} alt={`${animal.name} foto ${index + 1}`} class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Información y Apadrinamiento (5 Cols) -->
        <div class="lg:col-span-5 bg-white dark:bg-dark-card p-6 sm:p-8 rounded-3xl border border-zinc-200/80 dark:border-dark-border shadow-sm space-y-6">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-terracotta bg-brand-terracotta/10 px-3 py-1 rounded-full">
                {animal.type || 'Rescatado'}
              </span>
              <span class="text-xs text-zinc-400 flex items-center gap-1">
                <Calendar class="w-3.5 h-3.5" />
                {animal.rescuedDate || 'Rescatado recientemente'}
              </span>
            </div>

            <h1 class="text-3xl font-black text-zinc-900 dark:text-white">
              {animal.name}
            </h1>
            <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 mt-1">
              {animal.gender} • {animal.age}
            </p>
          </div>

          <!-- Historia -->
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-900 dark:text-white mb-2">
              Su Historia
            </h2>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
              {animal.fullStory || animal.description}
            </p>
          </div>

          <!-- Estado de Salud -->
          <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800">
            <h2 class="text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-white mb-3 flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-emerald-500" />
              Estado de Salud
            </h2>
            <ul class="space-y-2">
              {(animal.healthStatus || ['Vacunado/a', 'Esterilizado/a', 'En revisión periódica']).map((item) => (
                <li class="flex items-center gap-2 text-xs text-zinc-600 dark:text-zinc-300">
                  <CheckCircle2 class="w-3.5 h-3.5 text-emerald-500 shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Aporte Sugerido y Acción -->
          <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800 bg-brand-beige/40 dark:bg-zinc-800/40 p-4 rounded-2xl">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400">
              Aporte mensual sugerido
            </p>
            <p class="text-2xl font-black text-brand-terracotta mt-0.5">
              {animal.monthlyGoal || '$100.000 COP'}
            </p>

            <a
              href="/#apadrinar"
              class="mt-4 w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-xs font-bold text-white bg-brand-terracotta hover:bg-brand-terracotta-hover transition-colors shadow-md"
            >
              <Heart class="w-4 h-4 fill-current" />
              <span>Apadrinar a {animal.name}</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>