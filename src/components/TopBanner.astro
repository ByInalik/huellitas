---
import { Heart } from 'lucide-astro';
---

<div class="bg-brand-terracotta text-white text-xs py-2.5 px-4 text-center font-semibold flex items-center justify-center gap-2 relative z-50 border-b border-orange-600/30">
  <span class="flex h-2 w-2 relative">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
  </span>
  
  <span>Meta del mes: ¡Buscamos padrinos para 450 kg de comida!</span>
  
  <a 
    href="#donar" 
    class="underline underline-offset-2 hover:text-amber-200 font-bold transition-colors inline-flex items-center gap-1 ml-1"
  >
    <span>Apoyar ahora</span>
    <Heart class="w-3 h-3 fill-current" />
  </a>
</div>