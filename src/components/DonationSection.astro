---
import { Heart, Copy, Check, MessageSquare, ShieldCheck, Utensils, Stethoscope, Home } from 'lucide-astro';

const paymentMethods = [
  {
    name: "Nequi",
    account: "300 123 4567",
    qr: "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=Nequi-3001234567",
    color: "bg-purple-600/10 text-purple-400 border-purple-500/30"
  },
  {
    name: "Bancolombia",
    account: "Ahorros: 123-456789-01",
    qr: "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=Bancolombia-12345678901",
    color: "bg-amber-600/10 text-amber-400 border-amber-500/30"
  },
  {
    name: "Daviplata",
    account: "300 123 4567",
    qr: "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=Daviplata-3001234567",
    color: "bg-red-600/10 text-red-400 border-red-500/30"
  }
];

const kits = [
  { icon: Utensils, title: "Kit Nutrición", desc: "Cubre bultos de comida y concentrado mensual." },
  { icon: Stethoscope, title: "Kit Salud", desc: "Financia vacunas, antiparasitarios y tratamientos." },
  { icon: Home, title: "Kit Confort", desc: "Aporta camas, cobijas y reparación de espacios." }
];
---

<section id="donar" class="py-16 bg-zinc-950 text-white border-t border-zinc-900 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Header de sección -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-terracotta/10 border border-brand-terracotta/30 text-brand-terracotta text-xs font-bold uppercase tracking-wider">
        <Heart class="w-3.5 h-3.5 fill-current" />
        Haz la Diferencia
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mt-3">
        Apadrina o Realiza una Donación
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 mt-2">
        Cada aporte asegura alimento, refugio y atención médica para más de 80 rescatados.
      </p>
    </div>

    <!-- Grid principal: Slider QR + Información -->
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      
      <!-- LADO IZQUIERDO: Slider de QR de pago -->
      <div id="qr-card-container" class="lg:col-span-6 bg-zinc-900/80 border border-zinc-800 rounded-3xl p-6 sm:p-8 relative shadow-2xl">
        <div class="flex items-center justify-between mb-6">
          <span class="text-xs font-bold uppercase tracking-wider text-zinc-400">Métodos de Pago</span>
          <!-- Indicadores de Slide -->
          <div class="flex gap-2">
            {paymentMethods.map((_, i) => (
              <button
                class={`qr-dot w-2.5 h-2.5 rounded-full transition-all ${i === 0 ? 'bg-brand-terracotta w-6' : 'bg-zinc-700'}`}
                data-index={i}
                aria-label={`Ver método ${i + 1}`}
              />
            ))}
          </div>
        </div>

        <!-- Slides de QR -->
        <div class="relative min-h-[360px] flex items-center justify-center">
          {paymentMethods.map((method, index) => (
            <div
              class={`qr-slide absolute inset-0 flex flex-col items-center justify-center text-center transition-all duration-500 ${index === 0 ? 'opacity-100 z-10 pointer-events-auto scale-100' : 'opacity-0 z-0 pointer-events-none scale-95'}`}
              data-slide={index}
            >
              <span class={`px-3 py-1 rounded-full text-xs font-bold border mb-4 ${method.color}`}>
                {method.name}
              </span>

              <div class="p-4 bg-white rounded-2xl shadow-xl mb-4">
                <img src={method.qr} alt={`QR ${method.name}`} class="w-44 h-44 object-contain" />
              </div>

              <p class="text-[11px] text-zinc-400 mb-1">Número de cuenta / celular:</p>
              <div class="flex items-center gap-2 bg-zinc-950 px-4 py-2 rounded-xl border border-zinc-800">
                <span class="font-mono text-xs font-bold text-white">{method.account}</span>
                <button
                  type="button"
                  class="copy-btn text-zinc-400 hover:text-white transition-all flex items-center gap-1.5"
                  data-copy={method.account}
                  title="Copiar número"
                >
                  <Copy class="copy-icon w-4 h-4" />
                  <span class="copy-status text-[11px] font-semibold hidden">¡Copiado! ✓</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- LADO DERECHO: Información sobre el Apadrinamiento a Distancia -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-terracotta">
            ¿Cómo funciona el apadrinamiento a distancia?
          </span>
          <h3 class="text-2xl font-bold mt-1 text-white">
            Elige qué necesidades deseas cubrir
          </h3>
          <p class="text-xs sm:text-sm text-zinc-400 mt-2 leading-relaxed">
            Si no puedes adoptar físicamente, puedes apadrinar a un peludito financiado mes a mes según sus requerimientos directos:
          </p>
        </div>

        <!-- Kits de Apadrinamiento -->
        <div class="space-y-3">
          {kits.map((kit) => {
            const Icon = kit.icon;
            return (
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-zinc-900/50 border border-zinc-800/80 hover:border-brand-terracotta/40 transition-colors">
                <div class="p-2.5 rounded-xl bg-brand-terracotta/10 text-brand-terracotta shrink-0">
                  <Icon class="w-5 h-5" />
                </div>
                <div>
                  <h4 class="text-sm font-bold text-white">{kit.title}</h4>
                  <p class="text-xs text-zinc-400 mt-0.5">{kit.desc}</p>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Banner comprobante por WhatsApp -->
        <div class="p-5 rounded-2xl bg-emerald-950/40 border border-emerald-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h4 class="text-xs font-bold text-emerald-300">¿Realizaste tu aporte?</h4>
            <p class="text-[11px] text-zinc-400 mt-0.5">Envíanos el comprobante por WhatsApp para enviarte reportes de tu ahijado.</p>
          </div>
          <a
            href="https://wa.me/573000000000?text=Hola,%20adjunto%20comprobante%20de%20mi%20donación/apadrinamiento"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shrink-0 shadow-md"
          >
            <MessageSquare class="w-4 h-4 fill-current" />
            <span>Enviar Comprobante</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const qrSlides = document.querySelectorAll('.qr-slide');
  const qrDots = document.querySelectorAll('.qr-dot');
  const container = document.getElementById('qr-card-container');
  let currentQr = 0;
  let interval: any = null;

  function showQr(index: number) {
    qrSlides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none', 'scale-95');
        slide.classList.add('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100');
      } else {
        slide.classList.remove('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100');
        slide.classList.add('opacity-0', 'z-0', 'pointer-events-none', 'scale-95');
      }
    });

    qrDots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-brand-terracotta', 'w-6');
        dot.classList.remove('bg-zinc-700');
      } else {
        dot.classList.remove('bg-brand-terracotta', 'w-6');
        dot.classList.add('bg-zinc-700');
      }
    });

    currentQr = index;
  }

  function startAutoSlide() {
    if (!interval) {
      interval = setInterval(() => {
        const nextIndex = (currentQr + 1) % qrSlides.length;
        showQr(nextIndex);
      }, 4000); // Cambia automáticamente cada 4 segundos
    }
  }

  function stopAutoSlide() {
    clearInterval(interval);
    interval = null;
  }

  // Clic en los puntos indicadores
  qrDots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0');
      showQr(idx);
    });
  });

  // Pausar rotación si el usuario pasa el cursor por la tarjeta
  container?.addEventListener('mouseenter', stopAutoSlide);
  container?.addEventListener('mouseleave', startAutoSlide);

  // Iniciar slider
  startAutoSlide();

  // Copiar número de cuenta con microinteracción elegante (sin alert)
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLElement;
      const text = target.getAttribute('data-copy');
      const icon = target.querySelector('.copy-icon');
      const statusText = target.querySelector('.copy-status');

      if (text) {
        try {
          await navigator.clipboard.writeText(text);

          // Cambiar vista al estado copiado
          icon?.classList.add('hidden');
          statusText?.classList.remove('hidden');
          statusText?.classList.add('text-emerald-400');

          setTimeout(() => {
            icon?.classList.remove('hidden');
            statusText?.classList.add('hidden');
            statusText?.classList.remove('text-emerald-400');
          }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      }
    });
  });
</script>